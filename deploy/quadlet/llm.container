[Unit]
Description=vLLM LLM Server
After=network-online.target
Wants=network-online.target

[Service]
TimeoutStartSec=300

[Container]
Image=ghcr.io/nickcao/jerry/llm:latest
ContainerName=llm
AddDevice=nvidia.com/gpu=all
Network=host
Environment=HF_HUB_OFFLINE=1
Environment=VLLM_USE_V2_MODEL_RUNNER=1
Notify=healthy
HealthCmd=curl -sf http://localhost:8000/health
HealthInterval=5s
HealthStartPeriod=120s
Exec=vllm serve Qwen/Qwen2.5-3B-Instruct-AWQ \
    --port 8000 --enforce-eager \
    --max-model-len 2048 --kv-cache-memory-bytes 72M --gpu-memory-utilization 0.01 \
    --enable-auto-tool-choice --tool-call-parser hermes

[Install]
WantedBy=default.target
