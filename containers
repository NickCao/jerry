mkdir -p ~/.cache/huggingface 
podman run --name llm --rm -ti --device nvidia.com/gpu=all --network host \
    -v ~/.cache/huggingface:/data/models/huggingface:z \
    ghcr.io/nvidia-ai-iot/vllm:latest-jetson-orin vllm serve Qwen/Qwen2.5-3B-Instruct-AWQ \
    --port 8000 --max-model-len 2048 --kv-cache-memory-bytes 72M --enforce-eager \
    --enable-auto-tool-choice --tool-call-parser hermes --gpu-memory-utilization 0.01

podman run --name tts --rm -ti --device nvidia.com/gpu=all --network host \
    -v ~/.cache/huggingface:/data/models/huggingface:z \
    example.com/vllm-omni vllm serve --omni hexgrad/Kokoro-82M \
    --port 8001
